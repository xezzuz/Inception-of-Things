Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/debian-13"
  config.vm.box_architecture = "arm64"
  config.vm.synced_folder "./shared", "/vagrant/shared", type: "rsync"
  # TODO: add box_url

  # K3s Server Node
  config.vm.define "nazouzS" do |server|
    server.vm.hostname = "nazouzS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "nazouzS"
      vb.memory = 2048
      vb.cpus = 2
    end

    server.vm.provision "shell", path: "scripts/bootstrap-k3s-server-node.sh"
  end

  # K3s Worker Node
  config.vm.define "nazouzSW" do |worker|
    worker.vm.hostname = "nazouzSW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provider "virtualbox" do |vb|
      vb.name = "nazouzSW"
      vb.memory = 2048
      vb.cpus = 2
    end

    worker.vm.provision "shell", path: "scripts/bootstrap-k3s-agent-node.sh"
  end
end
